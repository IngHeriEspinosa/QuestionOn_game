# Puerto del servidor. Por defecto 3000.
PORT=3000

# OBLIGATORIA. Redis es la fuente de verdad de las partidas en curso:
# sin ella la aplicación no arranca.
#   - en local:   docker compose up -d redis   ->   redis://127.0.0.1:6379
#   - con docker compose completo:              ->   redis://redis:6379
REDIS_URL=redis://127.0.0.1:6379

# "true" solo si tu Redis exige TLS (proveedores gestionados).
REDIS_TLS=false

# Nivel de log: fatal|error|warn|info|debug|trace.
# Por defecto info en producción y debug en desarrollo.
LOG_LEVEL=

# OBLIGATORIA. Postgres guarda cuentas, quizzes y resultados.
#   - en local:  docker compose up -d postgres
#   - con docker compose completo: postgres://questionon:questionon@postgres:5432/questionon
DATABASE_URL=postgres://questionon:questionon@127.0.0.1:5432/questionon

# Puertos del host. Cambialos si esos numeros ya estan ocupados en tu maquina.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# Secreto para firmar las cookies de sesion. Generalo con:
#   openssl rand -base64 32
SESSION_SECRET=

# OBLIGATORIA EN PRODUCCION. URL publica por la que entra la gente.
# Se usa para construir los enlaces de acceso: detras de un proxy inverso,
# el origen de la peticion es la direccion interna y el enlace no serviria.
#   ejemplo: https://questionon.tucentro.es
APP_URL=

# --- Cobro (Stripe). Sin estas variables la app funciona, pero no cobra. ---
# Clave secreta de la API.
STRIPE_SECRET_KEY=
# Secreto del endpoint de webhook. En local: stripe listen --forward-to ...
STRIPE_WEBHOOK_SECRET=
# Identificadores de precio de cada plan, creados en el panel de Stripe.
STRIPE_PRICE_PRO=
STRIPE_PRICE_SCHOOL=

# Proveedor de correo. OBLIGATORIO en produccion: sin el, los enlaces de
# acceso se volcarian al log en vez de enviarse.
MAIL_PROVIDER=
